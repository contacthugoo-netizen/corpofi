.bar{height:6px;background:var(--rule);border-radius:3px;overflow:hidden;margin-top:6px;max-width:420px}
.bar i{display:block;height:100%;background:var(--ledger);width:0}
.cards{display:flex;flex-direction:column;gap:16px;margin-top:20px}
.card{background:var(--sheet);border:1px solid var(--rule);border-radius:6px;padding:18px clamp(14px,3vw,26px);min-width:0}
.card .meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-family:var(--mono);font-size:.74rem;color:var(--muted);margin-bottom:8px}
.card .meta .src{color:var(--ledger);font-weight:600}
.card .q{font-size:1.02rem;margin:4px 0 10px;max-width:72ch}
.card .q .stmt{display:block;margin:6px 0 0 0;padding-left:14px}
.opts{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.opt{display:grid;grid-template-columns:28px 1fr;gap:8px;align-items:baseline;text-align:left;font-family:var(--body);font-size:.98rem;color:var(--ink);background:var(--paper);border:1px solid var(--rule);border-radius:4px;padding:8px 12px;cursor:pointer}
.opt .k{font-family:var(--mono);font-size:.8rem;color:var(--muted)}
.opt:hover:not([disabled]){border-color:var(--ledger)}
.opt[disabled]{cursor:default}
.opt.right{background:var(--ledger-soft);border-color:var(--ledger)}
.opt.right .k{color:var(--ledger);font-weight:600}
.opt.wrong{background:var(--red-soft);border-color:var(--red)}
.opt.wrong .k{color:var(--red);font-weight:600}
.verdict{font-family:var(--display);font-stretch:108%;font-weight:700;margin-top:12px}
.verdict.ok{color:var(--ledger)}
.verdict.ko{color:var(--red)}
.why{margin-top:6px;padding:10px 14px;border-left:3px solid var(--ledger);background:var(--paper);border-radius:0 4px 4px 0;font-size:.97rem}
.note{margin-top:8px;font-size:.88rem;color:var(--muted);font-style:italic}
.cardfoot{display:flex;gap:10px;margin-top:10px}
.linkbtn{font-family:var(--display);font-size:.82rem;background:none;border:none;color:var(--muted);text-decoration:underline;cursor:pointer;padding:0}
.empty{padding:30px;text-align:center;color:var(--muted);border:1px dashed var(--rule);border-radius:6px}
.fig{margin:10px 0}
.fig svg{display:block;width:100%;max-width:420px;height:auto}
.fig .ax{stroke:var(--muted);stroke-width:1.2;fill:none}
.fig .fr{stroke:var(--ledger);stroke-width:2.2;fill:none}
.fig .frl{stroke:var(--muted);stroke-width:1.4;fill:none;stroke-dasharray:4 4}
.fig .tl{stroke:var(--red);stroke-width:2;fill:none}
.fig .pt{fill:var(--ink)}
.fig text{fill:var(--muted);font-family:var(--mono);font-size:10px}

/* formula sheet */
.fs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:16px;margin-top:18px}
.fs section{background:var(--sheet);border:1px solid var(--rule);border-radius:6px;padding:16px 18px;min-width:0}
.fs h3{margin:0 0 6px;padding:0;border:none;font-size:1.02rem}
.fs dl{margin:0}
