<style>
/* Layout: an accountant's ledger pad. Tab index on the left, one ruled reading column, a deck of exam cards to work through. */
:root{
  --paper:#ECF1EA;
  --sheet:#FAFCF7;
  --rule:#CBD9C6;
  --ink:#16221E;
  --muted:#55655E;
  --ledger:#1C6648;
  --ledger-soft:#D9E9DC;
  --red:#B23727;
  --red-soft:#F5DFD9;
  --mark:#F2E07A;
  --mark-ink:#16221E;
  --display:"Archivo","Arial Narrow",system-ui,sans-serif;
  --body:"Source Serif 4",Georgia,"Times New Roman",serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0F1613; --sheet:#151F1B; --rule:#2A3832; --ink:#E2ECE6; --muted:#93A39B;
    --ledger:#5DC497; --ledger-soft:#1B3328; --red:#F28470; --red-soft:#3A211C; --mark:#5B5220; --mark-ink:#F4EBC0;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0F1613; --sheet:#151F1B; --rule:#2A3832; --ink:#E2ECE6; --muted:#93A39B;
  --ledger:#5DC497; --ledger-soft:#1B3328; --red:#F28470; --red-soft:#3A211C; --mark:#5B5220; --mark-ink:#F4EBC0;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6;padding-inline:16px;padding-block:0 64px}
a{color:var(--ledger)}
:focus-visible{outline:2px solid var(--ledger);outline-offset:2px}

/* ---------- top bar ---------- */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--paper);border-bottom:1px solid var(--rule);margin-inline:-16px;padding:10px 16px}
.top-in{max-width:1180px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:10px 24px;justify-content:space-between}
.brand{display:flex;flex-direction:column;line-height:1.15}
.brand b{font-family:var(--display);font-stretch:118%;font-weight:800;font-size:1.15rem;letter-spacing:-.01em}
.brand span{font-family:var(--mono);font-size:.72rem;color:var(--muted)}
.modes{display:flex;gap:4px;background:var(--sheet);border:1px solid var(--rule);border-radius:999px;padding:3px}
.modes a{font-family:var(--display);font-stretch:105%;font-weight:600;font-size:.88rem;text-decoration:none;color:var(--muted);padding:6px 14px;border-radius:999px}
.modes a[aria-current="page"]{background:var(--ledger);color:var(--sheet)}

/* ---------- layout ---------- */
.wrap{max-width:1180px;margin:24px auto 0;display:grid;grid-template-columns:220px minmax(0,1fr);gap:32px}
.wrap.solo{grid-template-columns:minmax(0,1fr)}
.index{position:sticky;top:calc(env(safe-area-inset-top,0px) + 76px);align-self:start}
.index h4{font-family:var(--display);font-stretch:110%;text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;color:var(--muted);margin:0 0 8px}
.index ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.index a{display:grid;grid-template-columns:28px 1fr;align-items:baseline;text-decoration:none;color:var(--ink);font-family:var(--display);font-size:.92rem;padding:6px 8px;border-radius:4px}
.index a:hover{background:var(--ledger-soft)}
.index a .no{font-family:var(--mono);font-size:.75rem;color:var(--muted)}
main{min-width:0}
@media (max-width:860px){
  .wrap{grid-template-columns:minmax(0,1fr)}
  .index{position:static}
  .index ol{flex-direction:row;overflow-x:auto;gap:6px;padding-bottom:6px}
  .index a{grid-template-columns:auto auto;gap:6px;white-space:nowrap;border:1px solid var(--rule);background:var(--sheet)}
}

/* ---------- reading sheets ---------- */
.sheet{background:var(--sheet);border:1px solid var(--rule);border-radius:6px;padding:28px clamp(18px,4vw,48px) 36px;min-width:0}
.sheet + .sheet{margin-top:28px}
.prose{max-width:68ch}
.eyebrow{font-family:var(--mono);font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ledger)}
h1,h2,h3{font-family:var(--display);text-wrap:balance;line-height:1.15;margin:0}
h1{font-stretch:120%;font-weight:800;font-size:clamp(1.8rem,4.2vw,2.6rem);letter-spacing:-.02em}
h2{font-stretch:118%;font-weight:800;font-size:clamp(1.5rem,3.2vw,2rem);letter-spacing:-.015em;margin-top:4px}
h3{font-stretch:108%;font-weight:700;font-size:1.18rem;margin-top:34px;padding-top:14px;border-top:1px solid var(--rule)}
h4{font-family:var(--display);font-weight:700;font-size:1rem;margin:22px 0 4px}
p{margin:10px 0}
.lede{font-size:1.12rem;color:var(--ink);margin-top:12px}
.muted{color:var(--muted)}
b,strong{font-weight:600}
mark{background:linear-gradient(100deg,transparent 2%,var(--mark) 4%,var(--mark) 96%,transparent 98%);color:var(--mark-ink);padding:0 .2em;border-radius:2px}
ul.clean,ol.steps{padding-left:1.2em;margin:8px 0}
ul.clean li,ol.steps li{margin:4px 0}

/* intro card */
.how{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-top:20px}
.how div{border:1px solid var(--rule);border-radius:4px;padding:12px 14px;background:var(--paper)}
.how b{display:block;font-family:var(--display);font-stretch:110%}
.how span{font-size:.95rem;color:var(--muted)}

/* formula block */
.formula{border:1px solid var(--rule);border-radius:4px;padding:14px 16px;margin:14px 0;background:var(--paper)}
.formula .lab{font-family:var(--display);font-stretch:110%;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;color:var(--ledger);margin-bottom:6px}
.f{font-family:var(--mono);font-size:.98rem;display:flex;flex-wrap:wrap;align-items:center;gap:.35em .45em}
.f + .f{margin-top:10px}
.frac{display:inline-flex;flex-direction:column;text-align:center;vertical-align:middle}
.frac>span:first-child{border-bottom:1.5px solid currentColor;padding:0 .35em 2px}
.frac>span:last-child{padding:2px .35em 0}
.formula .words{font-size:.95rem;color:var(--muted);margin:8px 0 0}
sup{font-size:.7em}

/* ledger table (worked examples) */
.tablewrap{overflow-x:auto;margin:14px 0;border:1px solid var(--rule);border-radius:4px;background:var(--sheet)}
table{border-collapse:collapse;width:100%;font-size:.93rem}
th,td{padding:7px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule)}
tr:last-child td{border-bottom:none}
th{font-family:var(--display);font-stretch:106%;font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);background:var(--paper)}
td.n,th.n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
td.w{font-family:var(--mono);font-size:.85rem;color:var(--muted)}
.ledger td.n{border-left:1px solid var(--rule)}
tr.tot td{font-weight:600;border-top:2px solid var(--ink)}
.neg{color:var(--red)}
.caption{font-family:var(--mono);font-size:.75rem;color:var(--muted);padding:8px 12px;border-top:1px solid var(--rule);background:var(--paper)}

/* trap */
.trap{border:1.5px dashed var(--red);border-radius:4px;padding:12px 16px;margin:16px 0;background:var(--red-soft)}
.trap .lab{font-family:var(--display);font-stretch:110%;text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;color:var(--red);font-weight:700}
.trap ul{margin:6px 0 0;padding-left:1.1em}
.trap li{margin:4px 0}
.goprac{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:28px;padding-top:16px;border-top:2px solid var(--ink)}
.btn{font-family:var(--display);font-stretch:106%;font-weight:700;font-size:.9rem;border:1.5px solid var(--ledger);background:var(--ledger);color:var(--sheet);padding:8px 16px;border-radius:999px;cursor:pointer;text-decoration:none}
.btn.ghost{background:transparent;color:var(--ledger)}
.btn:hover{filter:brightness(1.08)}

/* ---------- practice ---------- */
.ptop{display:flex;flex-direction:column;gap:14px}
